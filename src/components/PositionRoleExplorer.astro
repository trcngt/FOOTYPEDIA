      code: 'IWB / LB-RB',
      desc: 'Khi có bóng, hậu vệ này bó thẳng vào trung lộ tạo thành cặp tiền vệ trụ kép (Double Pivot) giúp áp đảo quân số tuyến giữa và chống phản công trung lộ.',
      skills: ['Tư duy vị trí & Giữ cự ly', 'Kỹ năng chuyền ngắn chuẩn xác', 'Thoát pressing trung lộ', 'Đánh chặn từ xa'],
      archetypes: 'Trent Alexander-Arnold, John Stones, Oleksandr Zinchenko, Philipp Lahm',
      heatmap: `<ellipse cx="210" cy="225" rx="65" ry="40" fill="rgba(239, 68, 68, 0.5)" filter="blur(8px)"/>
                <ellipse cx="140" cy="265" rx="55" ry="30" fill="rgba(245, 158, 11, 0.5)" filter="blur(6px)"/>`,
      marker: { x: 195, y: 235, label: 'IWB' },
      arrow: { x1: 130, y1: 270, x2: 215, y2: 215 }
    },
    'att-wingback': {
      name: 'Hậu vệ biên tấn công (Attacking Wing-Back)',
      code: 'WB / LWB-RWB',
      desc: 'Bao quát toàn bộ hành lang cánh. Nhiệm vụ chính là dâng cao sát đường biên ngang sân đối phương để tạt bóng hoặc xâm nhập vòng cấm dứt điểm.',
      skills: ['Thể lực bền bỉ phi thường', 'Tốc độ & Bứt tốc đoạn dài', 'Kỹ năng tạt bóng điểm rơi', 'Ý thức lùi về bọc lót'],
      archetypes: 'Alphonso Davies, Achraf Hakimi, Roberto Carlos, Andy Robertson',
      heatmap: `<ellipse cx="280" cy="285" rx="140" ry="25" fill="rgba(239, 68, 68, 0.55)" filter="blur(8px)"/>
                <ellipse cx="380" cy="285" rx="60" ry="20" fill="rgba(245, 158, 11, 0.65)" filter="blur(5px)"/>`,
      marker: { x: 320, y: 285, label: 'RWB' },
      arrow: { x1: 160, y1: 285, x2: 430, y2: 285 }
    },
    'bpd': {
