      skills: ['Khai thác khoảng trống Half-space', 'Kỹ năng rê dắt & Chọc khe', 'Căng ngang & Tạt sệt', 'Độ nhạy bàn thắng'],
      archetypes: 'Kevin De Bruyne, Andrés Iniesta, Bernardo Silva, Paul Pogba',
      heatmap: `<ellipse cx="320" cy="100" rx="75" ry="35" fill="rgba(239, 68, 68, 0.55)" filter="blur(8px)"/>
                <circle cx="335" cy="95" r="30" fill="rgba(245, 158, 11, 0.7)" filter="blur(5px)"/>`,
      marker: { x: 320, y: 100, label: 'MEZ' },
      arrow: { x1: 260, y1: 130, x2: 380, y2: 75 }
    },
    'false-9': {
      name: 'Số 9 Ảo (False 9)',
      code: 'F9 / CF',
      desc: 'Được bố trí cao nhất nhưng liên tục lùi sâu về tuyến giữa để kéo dãn các trung vệ đối phương, tạo khoảng trống cho các tiền đạo cánh băng vào ghi bàn.',
      skills: ['Kỹ năng rê dắt & Chạm bóng một chạm', 'Tư duy kiến tạo sắc bén', 'Thoát kèm người thông minh', 'Dứt điểm tinh tế'],
      archetypes: 'Lionel Messi (2009-2012), Roberto Firmino, Francesco Totti, Harry Kane',
      heatmap: `<ellipse cx="330" cy="170" rx="70" ry="55" fill="rgba(239, 68, 68, 0.55)" filter="blur(8px)"/>
                <circle cx="300" cy="170" r="35" fill="rgba(245, 158, 11, 0.7)" filter="blur(6px)"/>`,
      marker: { x: 320, y: 170, label: 'F9' },
      arrow: { x1: 410, y1: 170, x2: 290, y2: 170 }
    },
    'inv-winger': {
      name: 'Tiền đạo cánh nghịch chân (Inverted Winger)',
      code: 'IW / LW-RW',
      desc: 'Cầu thủ thuận chân trái đá cánh phải (hoặc ngược lại), liên tục rê bóng cắt chéo vào trung lộ để tung ra các cú cứa lòng cong vút hoặc chọc khe xé toang hàng thủ.',
      skills: ['Rê bóng 1v1 kỹ thuật', 'Cứa lòng & Sút xa hiểm hóc', 'Tốc độ đổi hướng cực nhanh', 'Phối hợp đập nhả bật tường'],
      archetypes: 'Arjen Robben, Mohamed Salah, Kylian Mbappé, Bukayo Saka, Vinícius Júnior',
      heatmap: `<ellipse cx="375" cy="70" rx="60" ry="30" fill="rgba(239, 68, 68, 0.5)" filter="blur(8px)"/>
                <ellipse cx="370" cy="120" rx="45" ry="35" fill="rgba(245, 158, 11, 0.65)" filter="blur(6px)"/>`,
      marker: { x: 375, y: 75, label: 'IW' },
      arrow: { x1: 390, y1: 65, x2: 370, y2: 135 }
    },
    'target-man': {
      name: 'Tiền đạo mục tiêu (Target Man)',
      code: 'TM / ST',
      desc: 'Ngọn hải đăng trong vòng cấm với thể hình lý tưởng, tì đè làm tường cho đồng đội băng lên hoặc trực tiếp không chiến ghi bàn từ các quả tạt.',
      skills: ['Thể hình & Sức mạnh tì đè', 'Không chiến & Đánh đầu dũng mãnh', 'Kỹ năng làm tường (Hold-up play)', 'Khả năng chớp thời cơ trong vòng cấm'],
      archetypes: 'Erling Haaland, Zlatan Ibrahimović, Olivier Giroud, Didier Drogba',
      heatmap: `<ellipse cx="430" cy="170" rx="45" ry="50" fill="rgba(239, 68, 68, 0.6)" filter="blur(8px)"/>
                <circle cx="435" cy="170" r="28" fill="rgba(245, 158, 11, 0.75)" filter="blur(5px)"/>`,
      marker: { x: 435, y: 170, label: 'TM' }
    }
  };

  function initRoleExplorer() {
    const navBtns = document.querySelectorAll('.nav-btn');
    const roleGroups = document.querySelectorAll('.role-group');
    const roleBtns = document.querySelectorAll('.role-btn');

    const nameEl = document.getElementById('role-name');
    const codeEl = document.getElementById('role-code');
    const descEl = document.getElementById('role-desc');
    const skillsEl = document.getElementById('role-skills');
    const archEl = document.getElementById('role-archetypes');
    const heatmapLayer = document.getElementById('heatmap-layer');
    const markerLayer = document.getElementById('marker-layer');

    function renderRole(key: string) {
      const data = roleDataset[key];
      if (!data) return;

      if (nameEl) nameEl.textContent = data.name;
      if (codeEl) codeEl.textContent = data.code;
      if (descEl) descEl.textContent = data.desc;
      if (archEl) archEl.textContent = data.archetypes;

      if (skillsEl) {
        skillsEl.innerHTML = data.skills.map(s => `<span class="skill-tag">${s}</span>`).join('');
      }

      if (heatmapLayer) {
        heatmapLayer.innerHTML = data.heatmap;
      }

      if (markerLayer) {
        let svgContent = `
          <circle cx="${data.marker.x}" cy="${data.marker.y}" r="15" fill="#0284c7" stroke="#ffffff" stroke-width="2.5" />
          <text x="${data.marker.x}" y="${data.marker.y + 4}" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle">${data.marker.label}</text>
        `;

        if (data.arrow) {
          svgContent += `
            <defs>
              <marker id="arrowhead" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
                <polygon points="0 0, 8 3, 0 6" fill="#38bdf8" />
              </marker>
            </defs>
            <line x1="${data.arrow.x1}" y1="${data.arrow.y1}" x2="${data.arrow.x2}" y2="${data.arrow.y2}" 
                  stroke="#38bdf8" stroke-width="3.5" stroke-dasharray="4,3" marker-end="url(#arrowhead)" />
          `;
        }

        markerLayer.innerHTML = svgContent;
      }

      roleBtns.forEach(btn => {
        if (btn.getAttribute('data-role') === key) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    navBtns.forEach(tab => {
      tab.addEventListener('click', () => {
        navBtns.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const line = tab.getAttribute('data-line');
        roleGroups.forEach(g => g.classList.remove('active'));

        const targetGroup = document.getElementById(`group-${line}`);
        if (targetGroup) {
          targetGroup.classList.add('active');
          const firstRoleBtn = targetGroup.querySelector('.role-btn') as HTMLElement;
          if (firstRoleBtn) {
            firstRoleBtn.click();
          }
        }
      });
    });

    roleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-role') || 'sweeper-gk';
        renderRole(key);
      });
    });

    renderRole('sweeper-gk');
  }

  document.addEventListener('DOMContentLoaded', initRoleExplorer);
</script>