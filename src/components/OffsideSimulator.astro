---
// OffsideSimulator.astro
---

<div class="offside-container">
  <div class="header-status">
    <div id="status-badge" class="badge onside">✅ HỢP LỆ (ONSIDE)</div>
    <p id="status-desc" class="desc">Kéo cầu thủ tấn công (Chấm Xanh Dương) hoặc hậu vệ (Chấm Đỏ) để thử nghiệm.</p>
  </div>

  <div class="pitch" id="pitch">
    <!-- Vạch giữa sân -->
    <div class="halfway-line"></div>
    <div class="center-circle"></div>
    <div class="penalty-box"></div>

    <!-- Đường việt vị ảo (Offside Line) -->
    <div class="offside-line" id="offside-line"></div>

    <!-- Vùng việt vị (Offside Zone) -->
    <div class="offside-zone" id="offside-zone"></div>

    <!-- Cầu thủ phòng ngự (Đỏ) -->
    <div class="player defender gk" id="gk" style="left: 93%; top: 50%;">GK</div>
    <div class="player defender" id="def1" style="left: 74%; top: 28%;">HV 1</div>
    <div class="player defender" id="def2" style="left: 70%; top: 68%;">HV 2</div>

    <!-- Cầu thủ tấn công (Xanh dương) -->
    <div class="player attacker passer" id="passer" style="left: 38%; top: 50%;">CHUYỀN</div>
    <div class="player attacker receiver" id="receiver" style="left: 64%; top: 38%;">T.ĐẠO</div>

    <!-- Quả bóng -->
    <div class="ball" id="ball" style="left: 42%; top: 53%;">⚽</div>
  </div>

  <!-- Bảng chú giải vị trí -->
  <div class="legend-bar">
    <span class="legend-item"><strong style="color: #38bdf8;">CHUYỀN:</strong> Người chuyền</span>
    <span class="legend-item"><strong style="color: #60a5fa;">T.ĐẠO:</strong> Tiền đạo nhận bóng</span>
    <span class="legend-item"><strong style="color: #f87171;">HV 1 / HV 2:</strong> Hậu vệ đối phương</span>
    <span class="legend-item"><strong style="color: #ef4444;">GK:</strong> Thủ môn</span>
  </div>

  <div class="controls-panel">
    <button class="btn-reset" id="btn-reset">Đặt lại vị trí ban đầu</button>
  </div>
</div>

<style>
  .offside-container {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.5rem;
    color: #fff;
    margin: 2rem 0;
    user-select: none;
  }
  .header-status {
    text-align: center;
    margin-bottom: 1rem;
  }
  .badge {
    display: inline-block;
    padding: 0.45rem 1.2rem;
    border-radius: 20px;
    font-weight: 700;
    font-size: 1.05rem;
    transition: background-color 0.3s;
  }
  .badge.onside { background: #16a34a; }
  .badge.offside { background: #dc2626; }
  .desc {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-top: 0.5rem;
  }
  .pitch {
    position: relative;
    width: 100%;
    height: 360px;
    background: #15803d;
    border: 3px solid #fff;
    border-radius: 8px;
    overflow: hidden;
    touch-action: none;
  }
  .halfway-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.6);
  }
  .center-circle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 80px;
    height: 80px;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .penalty-box {
    position: absolute;
    right: 0;
    top: 18%;
    width: 20%;
    height: 64%;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-right: none;
  }
  .offside-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background: #38bdf8;
    z-index: 2;
    transition: left 0.05s ease-out;
  }
  .offside-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    background: rgba(220, 38, 38, 0.22);
    z-index: 1;
  }
  
  /* Cầu thủ - Căn giữa chữ tuyệt đối, không tràn */
  .player {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: -0.2px;
    white-space: nowrap;
    text-align: center;
    cursor: grab;
    z-index: 5;
    box-shadow: 0 4px 10px rgba(0,0,0,0.4);
    box-sizing: border-box;
    padding: 2px;
  }
  .player:active { cursor: grabbing; }
  .defender { background: #ef4444; border: 2.5px solid #fff; color: #fff; }
  .attacker { background: #2563eb; border: 2.5px solid #fff; color: #fff; }
  .attacker.passer { font-size: 0.62rem; }
  
  .ball {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: 1.3rem;
    z-index: 4;
    cursor: grab;
    line-height: 1;
  }
  .legend-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    background: #0f172a;
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
    margin-top: 0.8rem;
    font-size: 0.78rem;
    color: #94a3b8;
    justify-content: center;
  }
  .controls-panel {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 0.8rem;
  }
  .btn-reset {
    background: #334155;
    color: #cbd5e1;
    border: 1px solid #475569;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-reset:hover {
    background: #475569;
    color: #fff;
  }
</style>

<script>
  function initOffside() {
    const pitch = document.getElementById('pitch');
    const offsideLine = document.getElementById('offside-line');
    const offsideZone = document.getElementById('offside-zone');
    const statusBadge = document.getElementById('status-badge');
    const statusDesc = document.getElementById('status-desc');

    const receiver = document.getElementById('receiver');
    const passer = document.getElementById('passer');
    const def1 = document.getElementById('def1');
    const def2 = document.getElementById('def2');
    const ball = document.getElementById('ball');
    const btnReset = document.getElementById('btn-reset');

    const players = [receiver, passer, def1, def2, ball];
    let activeDrag = null;

    players.forEach(el => {
      if (!el) return;
      el.addEventListener('pointerdown', (e) => {
        activeDrag = el;
        el.setPointerCapture(e.pointerId);
      });

      el.addEventListener('pointermove', (e) => {
        if (!activeDrag || !pitch) return;
        const rect = pitch.getBoundingClientRect();
        let x = ((e.clientX - rect.left) / rect.width) * 100;
        let y = ((e.clientY - rect.top) / rect.height) * 100;

        x = Math.max(5, Math.min(95, x));
        y = Math.max(5, Math.min(95, y));

        activeDrag.style.left = `${x}%`;
        activeDrag.style.top = `${y}%`;

        calculateOffside();
      });

      el.addEventListener('pointerup', () => { activeDrag = null; });
      el.addEventListener('pointercancel', () => { activeDrag = null; });
    });

    function getX(el) {
      return parseFloat(el.style.left);
    }

    function calculateOffside() {
      const defXList = [getX(def1), getX(def2)].sort((a, b) => b - a);
      const secondLastDefX = defXList[1]; // Vị trí hậu vệ áp chót

      const offsideX = Math.max(50, secondLastDefX);

      if (offsideLine && offsideZone) {
        offsideLine.style.left = `${offsideX}%`;
        offsideZone.style.left = `${offsideX}%`;
        offsideZone.style.width = `${100 - offsideX}%`;
      }

      const receiverX = getX(receiver);
      const ballX = getX(ball);

      const isPastHalfway = receiverX > 50;
      const isPastDefender = receiverX > secondLastDefX;
      const isPastBall = receiverX > ballX;

      if (isPastHalfway && isPastDefender && isPastBall) {
        statusBadge.className = 'badge offside';
        statusBadge.textContent = '❌ VIỆT VỊ (OFFSIDE)';
        statusDesc.textContent = `Tiền đạo vượt qua hậu vệ áp chót (${secondLastDefX.toFixed(1)}%) và đứng trước bóng!`;
        offsideLine.style.background = '#ef4444';
      } else {
        statusBadge.className = 'badge onside';
        statusBadge.textContent = '✅ HỢP LỆ (ONSIDE)';
        if (!isPastHalfway) {
          statusDesc.textContent = 'Hợp lệ: Tiền đạo vẫn đang ở phần sân nhà.';
        } else if (!isPastBall) {
          statusDesc.textContent = 'Hợp lệ: Tiền đạo đứng ngang hoặc sau trái bóng.';
        } else {
          statusDesc.textContent = 'Hợp lệ: Tiền đạo đứng trên hoặc ngang hàng với hậu vệ áp chót.';
        }
        offsideLine.style.background = '#38bdf8';
      }
    }

    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (receiver) { receiver.style.left = '64%'; receiver.style.top = '38%'; }
        if (passer) { passer.style.left = '38%'; passer.style.top = '50%'; }
        if (def1) { def1.style.left = '74%'; def1.style.top = '28%'; }
        if (def2) { def2.style.left = '70%'; def2.style.top = '68%'; }
        if (ball) { ball.style.left = '42%'; ball.style.top = '53%'; }
        calculateOffside();
      });
    }

    calculateOffside();
  }

  document.addEventListener('DOMContentLoaded', initOffside);
</script>