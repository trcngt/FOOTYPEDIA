---
// FormationMorpher.astro
---

<div class="morpher-container">
  <!-- Bảng chọn 6 Hệ thống chiến thuật (Grid 3x2 đều chằn chặn, không icon) -->
  <div class="system-grid-picker">
    <button class="sys-btn active" data-system="pep-3241">3-2-4-1</button>
    <button class="sys-btn" data-system="klopp-235">2-3-5</button>
    <button class="sys-btn" data-system="inzaghi-352">3-5-2</button>
    <button class="sys-btn" data-system="ancelotti-diamond">4-4-2 Diamond</button>
    <button class="sys-btn" data-system="simeone-442">4-4-2 Low-Block</button>
    <button class="sys-btn" data-system="classic-4231">4-2-3-1</button>
  </div>

  <!-- Nút chuyển đổi trạng thái: Chia đều 50% mỗi bên -->
  <div class="phase-switch-bar">
    <button class="phase-btn" data-phase="defend">
      Khi Mất Bóng (Phòng Ngự)
    </button>
    <button class="phase-btn active" data-phase="attack">
      Khi Có Bóng (Triển Khai)
    </button>
  </div>

  <!-- Bố cục Sân 2D & Thông số chiến thuật -->
  <div class="display-grid">
    <!-- Sân 2D minh họa 11 cầu thủ -->
    <div class="pitch-card">
      <div class="pitch-header">
        <span class="pitch-title" id="formation-name">Sơ đồ: 3-2-4-1 (Kiểm soát áp đảo)</span>
        <span class="attack-dir">Tấn công ➔</span>
      </div>

      <div class="pitch-wrapper">
        <div class="pitch-board" id="pitch-board">
          <!-- Vạch sân -->
          <div class="half-line"></div>
          <div class="center-circle"></div>
          <div class="box-left"></div>
          <div class="box-right"></div>

          <!-- 11 Cầu thủ -->
          <div class="node gk" id="p-gk">GK</div>
          <div class="node" id="p-1">1</div>
          <div class="node" id="p-2">2</div>
          <div class="node" id="p-3">3</div>
          <div class="node" id="p-4">4</div>
          <div class="node" id="p-5">5</div>
          <div class="node" id="p-6">6</div>
          <div class="node" id="p-7">7</div>
          <div class="node" id="p-8">8</div>
          <div class="node" id="p-9">9</div>
          <div class="node" id="p-10">10</div>
        </div>
      </div>
    </div>

    <!-- Bảng phân tích chuyển thái -->
    <div class="info-card">
      <div class="info-header">
        <h3 id="phase-title">Pha Triển Khai Bóng (Build-up Phase)</h3>
        <span class="badge-phase" id="phase-badge">In-Possession</span>
      </div>

      <p class="phase-desc" id="phase-desc">
        Hậu vệ cánh bó hẳn vào trung lộ đá cặp tiền vệ trụ kép (Double Pivot). Hai tiền vệ công dâng cao chiếm lĩnh khoảng trống Half-space tạo nên cấu trúc 5 tiền đạo áp đảo tuyến trên.
      </p>

      <div class="tactical-notes">
        <div class="note-item">
          <strong>Cấu trúc khối:</strong>
          <span id="note-structure">3 Trung vệ + 2 Tiền vệ mỏ neo + 5 Mũi công (3-2-4-1)</span>
        </div>
        <div class="note-item">
          <strong>Mục tiêu chiến thuật:</strong>
          <span id="note-objective">Tạo ưu thế quân số tuyến giữa (+1 Overload) và khóa chặt các đường phản công nhanh.</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .morpher-container {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.25rem;
    color: #fff;
    margin: 2rem 0;
    width: 100%;
  }

  /* Grid 6 hệ thống: 3 cột x 2 hàng đều nhau 100% */
  .system-grid-picker {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0 0 0.75rem 0;
    padding: 0;
    align-items: stretch;
    width: 100%;
  }

  @media (max-width: 768px) {
    .system-grid-picker {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .system-grid-picker {
      grid-template-columns: 1fr;
    }
  }

  .sys-btn {
    height: 42px;
    width: 100%;
    margin: 0 !important;
    background: #0f172a;
    color: #cbd5e1;
    border: 1px solid #475569;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 0.5rem;
    line-height: 1;
    vertical-align: middle;
  }

  .sys-btn:hover {
    color: #fff;
    border-color: #38bdf8;
    background: #1e293b;
  }

  .sys-btn.active {
    background: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
  }

  /* Nút chuyển đổi trạng thái: 2 ô chia đều 50% */
  .phase-switch-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    background: #1e293b;
    padding: 0.6rem;
    border-radius: 8px;
    border: 1px solid #334155;
    margin-bottom: 1.25rem;
    align-items: stretch;
    width: 100%;
  }

  .phase-btn {
    height: 42px;
    width: 100%;
    margin: 0 !important;
    background: #0f172a;
    color: #94a3b8;
    border: 1px solid #475569;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    padding: 0 0.5rem;
    line-height: 1;
    vertical-align: middle;
  }

  .phase-btn:hover {
    color: #fff;
    border-color: #38bdf8;
  }

  .phase-btn.active {
    background: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
  }

  /* Layout 2 cột */
  .display-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 1.2rem;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .display-grid {
      grid-template-columns: 1fr;
    }
  }

  .pitch-card {
    background: #1e293b;
    border-radius: 8px;
    padding: 0.9rem;
    border: 1px solid #334155;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .pitch-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .pitch-title {
    font-size: 0.84rem;
    font-weight: 700;
    color: #38bdf8;
  }

  .attack-dir {
    font-size: 0.76rem;
    color: #94a3b8;
    background: rgba(56, 189, 248, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  /* Sân bóng tương tác với CSS Transition mượt */
  .pitch-wrapper {
    width: 100%;
  }

  .pitch-board {
    position: relative;
    width: 100%;
    height: 270px;
    background: #15803d;
    border: 2px solid #fff;
    border-radius: 6px;
    overflow: hidden;
  }

  .half-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.5);
  }

  .center-circle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60px;
    height: 60px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .box-left {
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 15%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-left: none;
  }

  .box-right {
    position: absolute;
    right: 0;
    top: 20%;
    bottom: 20%;
    width: 15%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-right: none;
  }

  /* 11 Node Cầu thủ */
  .node {
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #0284c7;
    border: 2px solid #fff;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    transition: left 0.6s cubic-bezier(0.4, 0, 0.2, 1), top 0.6s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s;
    box-shadow: 0 2px 6px rgba(0,0,0,0.4);
    z-index: 2;
    white-space: nowrap;
  }

  .node.gk {
    background: #f59e0b;
  }

  .info-card {
    background: #1e293b;
    border-radius: 8px;
    padding: 1.1rem;
    border: 1px solid #334155;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .info-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.5rem;
  }

  .info-header h3 {
    margin: 0;
    font-size: 1.05rem;
    color: #38bdf8;
  }

  .badge-phase {
    background: #0284c7;
    color: #fff;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .phase-desc {
    margin: 0;
    font-size: 0.85rem;
    color: #cbd5e1;
    line-height: 1.55;
  }

  .tactical-notes {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: #0f172a;
    padding: 0.75rem;
    border-radius: 6px;
    border-left: 3px solid #38bdf8;
  }

  .note-item {
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  .note-item strong {
    color: #f1f5f9;
    display: block;
    margin-bottom: 0.15rem;
  }
</style>

