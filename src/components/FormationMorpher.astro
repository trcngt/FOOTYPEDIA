  function initMorpher() {
    let currentSystem = 'pep-3241';
    let currentPhase = 'attack';

    const sysBtns = document.querySelectorAll('.sys-btn');
    const phaseBtns = document.querySelectorAll('.phase-btn');

    const formNameEl = document.getElementById('formation-name');
    const phaseTitleEl = document.getElementById('phase-title');
    const phaseBadgeEl = document.getElementById('phase-badge');
    const phaseDescEl = document.getElementById('phase-desc');
    const noteStructureEl = document.getElementById('note-structure');
    const noteObjectiveEl = document.getElementById('note-objective');

    const nodeIds = ['p-gk', 'p-1', 'p-2', 'p-3', 'p-4', 'p-5', 'p-6', 'p-7', 'p-8', 'p-9', 'p-10'];

    function updateBoard() {
      const data = systems[currentSystem];
      if (!data) return;

      const isAttack = currentPhase === 'attack';
      const coordsList = isAttack ? data.attack : data.defend;

      if (formNameEl) formNameEl.textContent = isAttack ? data.nameAttack : data.nameDefend;
      if (phaseTitleEl) phaseTitleEl.textContent = isAttack ? 'Pha Triển Khai Bóng (In-Possession)' : 'Pha Phòng Ngự (Out-of-Possession)';
      if (phaseBadgeEl) {
        phaseBadgeEl.textContent = isAttack ? 'In-Possession' : 'Out-of-Possession';
        phaseBadgeEl.style.background = isAttack ? '#0284c7' : '#dc2626';
      }
      if (phaseDescEl) phaseDescEl.textContent = isAttack ? data.descAttack : data.descDefend;
      if (noteStructureEl) noteStructureEl.textContent = isAttack ? data.structAttack : data.structDefend;
      if (noteObjectiveEl) noteObjectiveEl.textContent = isAttack ? data.objAttack : data.objDefend;

      coordsList.forEach((coord, idx) => {
        const nodeEl = document.getElementById(nodeIds[idx]);
        if (nodeEl) {
          nodeEl.style.left = `${coord.x}%`;
          nodeEl.style.top = `${coord.y}%`;
          nodeEl.textContent = coord.label;
        }
      });
    }

    sysBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        sysBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentSystem = btn.getAttribute('data-system') || 'pep-3241';
        updateBoard();
      });
    });

    phaseBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        phaseBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentPhase = btn.getAttribute('data-phase') || 'attack';
        updateBoard();
      });
    });

    updateBoard();
  }

  document.addEventListener('DOMContentLoaded', initMorpher);
</script>